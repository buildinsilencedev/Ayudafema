# ============================================================
# Ayudafema — Environment variables
# Copy to .env.local for local dev. Never commit real values.
# ============================================================

# --------------- Frontend (exposed to browser bundle) -------
# Get these from: https://supabase.com/dashboard/project/<id>/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sentry DSN for frontend error tracking (M8)
VITE_SENTRY_DSN=

# Full URL including protocol, no trailing slash.
# Used for auth magic-link redirects.
VITE_SITE_URL=http://localhost:5173

# --------------- Backend (Supabase edge function env) -------
# Never set VITE_ on these — they must not reach the browser.

# Supabase service role key (full DB access — guard carefully)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (LLM routing — Haiku 4.5 / Sonnet 4.6 / Opus 4.7)
OPENROUTER_API_KEY=sk-or-...

# OpenAI (text-embedding-3-small for RAG corpus — M4)
OPENAI_API_KEY=sk-...

# Twilio (SMS reminders + OTP — M6)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+18331234567
TWILIO_MESSAGING_SERVICE_SID=MG...

# Sentry DSN for backend edge functions (M8)
SENTRY_DSN_BACKEND=
