# ============================================================
# Ayudafema — Environment variables
# Copy to .env.local for local dev. Never commit real values.
# Every value below includes the exact dashboard path where
# it lives, so first-time deployers don't have to hunt.
# ============================================================

# ─── Frontend (public, shipped in browser bundle) ─────────────
# These are safe to expose. Vite inlines them at build time.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase → Project Settings → API → anon / public key
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sentry → Settings → Projects → ayudafema-fe → Client Keys (DSN)
# Optional. Leave blank to disable frontend error tracking.
VITE_SENTRY_DSN=

# Full URL of the deployed frontend, no trailing slash.
# Used for Supabase magic-link redirects. Must match the URL
# allow-list in Supabase → Authentication → URL Configuration.
VITE_SITE_URL=http://localhost:5173


# ─── Backend (secrets, Supabase edge-function-only) ───────────
# Never prefix these with VITE_ — they must not reach the browser.
# Set them via `npm run functions:secrets` (reads this file and
# pushes to `supabase secrets set`).

# Supabase → Project Settings → API → service_role key
# Full database access. Treat like a root password. Never ship
# to the browser. Never commit. Rotate if exposed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter → Keys → Create Key
# Routes LLM calls (Haiku 4.5 OCR, Sonnet 4.6 drafts, Opus 4.7
# complex appeals). Pay-per-use, no monthly minimum.
OPENROUTER_API_KEY=sk-or-...

# OpenAI → API keys → Create new secret key
# Used only for text-embedding-3-small when seeding the RAG
# corpus. One-time cost ~$0.01 for the initial ingest.
OPENAI_API_KEY=sk-...

# Twilio → Console Dashboard → Account Info → Account SID
TWILIO_ACCOUNT_SID=AC...

# Twilio → Console Dashboard → Account Info → Auth Token
TWILIO_AUTH_TOKEN=

# Twilio → Phone Numbers → Manage → Active numbers → your PR number
# Format: E.164 with country code, e.g. +17871234567
TWILIO_FROM_NUMBER=+17871234567

# Twilio → Messaging → Services → your Messaging Service → Service SID
# A Messaging Service lets you manage opt-outs and sticky sender
# across multiple numbers. Required for bilingual STOP/HELP handling.
TWILIO_MESSAGING_SERVICE_SID=MG...

# Sentry → Settings → Projects → ayudafema-be → Client Keys (DSN)
# Optional. Leave blank to disable backend error tracking.
SENTRY_DSN_BACKEND=

# Optional: email address of the first attorney who should be granted
# review privileges. If set, `npm run bootstrap` prints a ready-to-paste
# SQL snippet to promote this user the first time they log in. Remove
# or blank out after the first attorney is onboarded.
BOOTSTRAP_ATTORNEY_EMAIL=


# ─── Phase 2 only (n8n on Railway) ────────────────────────────
# Skip until traffic justifies the retry layer. See docs/ARCHITECTURE.md.

# Railway → your n8n service → Settings → Domains → Public URL
# Used by `npm run n8n:import` to upload workflow JSON.
N8N_WEBHOOK_URL=

# Basic auth protecting the n8n UI. Set these in Railway's
# variables tab on the n8n service, not just here.
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
